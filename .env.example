# GM Server Environment
# Generated GM wallet private key (required). Fund and register via setGameMaster().
GM_PRIVATE_KEY=

# API server
PORT=3001

# Avalanche Fuji config (defaults shown)
AVAX_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVAX_DIAMOND=0x3c1bd1923f8318247e2b60e41b0f280391c4e1e1

# Somnia Testnet config (defaults shown)
SOMNIA_RPC_URL=https://dream-rpc.somnia.network/
SOMNIA_DIAMOND=0xb34f8430f8a755c8c1bdc9dd19f14e263fc3f6b1

# ---- Agent subsystem ----
AGENTS_ENABLED=false
AGENTS_CHAIN_IDS=50312
AGENTS_LANGUAGE=English
AGENT_MASTER_MNEMONIC=
AGENT_SPONSOR_PRIVATE_KEY=

# ---- 4d DAY chat ----
# DAY chat is ON by default now. Set to false to opt out.
AGENTS_DAY_ENABLED=true

# Somnia inferChat result store — one address per chainId.
# Boot validation crashes if AGENTS_DAY_ENABLED=true and the env for an active chainId is unset.
# Testnet (50312):
LLM_CHAT_STORE_50312=0x07f351efdbd4478e3f31c2fdbd91d9e97ce76028
# Mainnet (5031):
LLM_CHAT_STORE_5031=

LLM_CHAT_AGENT_ID=12847293847561029384
# DAY-only cap. Typical chat latency 3.8-5.8s, but validators observed up to ~90s.
# 60s is a timeout CAP not a fixed wait — inferChat returns early on success.
# Safe vs DAY phase (= aliveCount*60s, sequential round-robin breaks gracefully on
# phase-recheck). Do NOT reuse this for VOTING (60s contract / 30s soft window → keep 25s).
LLM_CHAT_WAIT_MS=60000
LLM_CHAT_GAS_PRICE_GWEI=10
TX_GAS_PRICE_GWEI=10
AGENTS_DAY_LANGUAGE=English

# Scrubber mode: strict | lenient. "disabled" is allowed only when NODE_ENV=local.
SCRUBBER_MODE=strict

# Sponsor safety: skip an agent if sponsor balance below this (in STT).
SPONSOR_LOW_THRESHOLD_STT=1.5
